# ═══════════════════════════════════════════════════════════════════
# BIAGIOVISUALS — Variabili d'ambiente
# Copia questo file in ".env.local" e compila tutti i valori.
# .env.local è gitignored: non verrà mai committato nel repository.
# Su Vercel: aggiungi queste variabili in Project > Settings > Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── DATABASE (Neon PostgreSQL) ───────────────────────────────────────────────
#
# Neon fornisce DUE stringhe di connessione:
#   - Pooled:  usa PgBouncer, obbligatoria per le funzioni serverless (Vercel)
#   - Direct:  connessione diretta, usata SOLO da Prisma per le migrazioni
#
# Come trovarle: Neon Dashboard → tuo progetto → "Connection Details"
#   → seleziona "Connection string" → copia "Pooled" e "Direct"

DATABASE_URL="postgresql://USER:PASS@HOST-pooler.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST.neon.tech/DBNAME?sslmode=require"

# ── CLOUDFLARE R2 ────────────────────────────────────────────────────────────
#
# Come trovare i valori:
#   R2_ACCOUNT_ID   → Cloudflare Dashboard → in basso a destra
#   R2_ACCESS_KEY_ID
#   R2_SECRET_ACCESS_KEY → Cloudflare Dashboard → R2 → "Manage R2 API Tokens"
#                           → "Create API Token" → tipo "Object Read & Write"
#   R2_BUCKET_NAME  → nome del bucket che crei in R2

R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET_NAME="biagiovisuals-gallery"

# ── SICUREZZA: SESSIONI ──────────────────────────────────────────────────────
#
# Chiave segreta usata per firmare i cookie di sessione (JWT HS256).
# Deve essere lunga almeno 64 caratteri e completamente casuale.
#
# Genera con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

SESSION_SECRET="incolla-qui-128-caratteri-esadecimali-casuali"

# ── SICUREZZA: PASSWORD ADMIN ────────────────────────────────────────────────
#
# Hash bcrypt della tua password admin. La password in chiaro non va mai qui.
#
# Come generare l'hash (esegui UNA VOLTA dal terminale nella cartella del progetto):
#   node -e "const b=require('bcryptjs'); console.log(b.hashSync('TUA_PASSWORD_QUI', 12))"
#
# Il risultato inizia con "$2b$12$..." — incollalo qui sotto.
# IMPORTANTE: usa virgolette SINGOLE perché l'hash contiene $ che dotenv espanderebbe.

ADMIN_PASSWORD_HASH="\$2b\$12\$..."

# ── URL PUBBLICO ─────────────────────────────────────────────────────────────
#
# URL base del sito, usato per costruire i link galleria da inviare al cliente.
# In sviluppo locale usa http://localhost:3000
# In produzione usa il tuo dominio Vercel o il dominio custom.

NEXT_PUBLIC_BASE_URL="http://localhost:3000"
